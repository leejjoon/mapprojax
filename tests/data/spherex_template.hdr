SIMPLE  =                    T / conforms to FITS standard                      
BITPIX  =                  -64 / array data type                                
NAXIS   =                    2 / number of array dimensions                     
NAXIS1  =                 1201                                                  
NAXIS2  =                 1201                                                  
EXTEND  =                    T                                                  
WCSAXES =                    2 / Number of coordinate axes                      
CRPIX1  =                601.0 / Pixel coordinate of reference point            
CRPIX2  =                601.0 / Pixel coordinate of reference point            
CDELT1  =  -0.0016666666666667 / [deg] Coordinate increment at reference point  
CDELT2  =   0.0016666666666667 / [deg] Coordinate increment at reference point  
CUNIT1  = 'deg'                / Units of coordinate increment and value        
CUNIT2  = 'deg'                / Units of coordinate increment and value        
CTYPE1  = 'GLON-TAN'           / Galactic longitude, gnomonic projection        
CTYPE2  = 'GLAT-TAN'           / Galactic latitude, gnomonic projection         
CRVAL1  =              78.9293 / [deg] Coordinate value at reference point      
CRVAL2  =              0.48367 / [deg] Coordinate value at reference point      
LONPOLE =                180.0 / [deg] Native longitude of celestial pole       
LATPOLE =              0.48367 / [deg] Native latitude of celestial pole        
MJDREF  =                  0.0 / [d] MJD of fiducial time                       
